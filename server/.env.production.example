# 生产环境变量参考模板（此文件可安全提交到 Git）
#
# 本文件只含占位符，不含任何真实凭据。
# 实际部署请复制为 server/.env.production，或填写到部署平台的环境变量面板。
# 填写后可用 python scripts/env-readiness-check.py 自检。

# 运行环境
NODE_ENV=production
PORT=3000

# 数据源：生产只允许 mongodb。
# fallback 会在数据库不可用时静默回退到 JSON，导致写入丢失，禁止使用。
DATA_SOURCE_MODE=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# 本地数据根目录。即使在 mongodb 模式下仍会被直接读取，必须包含：
#   school_data.json、teachers.json、auth_credentials.json、
#   forum_data.json、online_exams.json、grade_subject_reports/
# 留空表示从当前工作目录向上级推断。
DATA_DIR=

# 认证：JWT_SECRET 至少 32 字符，建议 64 位随机十六进制
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
JWT_EXPIRES_IN=7d

# 演示账号：密码至少 12 字符
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<change-this-to-a-long-unique-password>
STUDENT_DEMO_PASSWORD=<change-this-to-a-long-unique-password>

# CORS：必须是真实 HTTPS 域名，不得为 localhost
CORS_ORIGIN=https://your-frontend.example.com

# 大模型助手：三个必须同时填写，或全部留空表示禁用
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
