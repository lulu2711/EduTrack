NODE_ENV=production
PORT=3000
DATA_SOURCE_MODE=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://your-frontend.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<change-this-to-a-long-unique-password>
STUDENT_DEMO_PASSWORD=<change-this-to-a-long-unique-password>
DATA_DIR=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
