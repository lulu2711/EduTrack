# 数据库配置
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/edu-tracker?retryWrites=true&w=majority

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 演示账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
STUDENT_DEMO_PASSWORD=change-this-student-demo-password

# 服务器配置
PORT=3000
NODE_ENV=development

# JSON 数据目录。留空时自动使用项目根目录；部署时可指定外部目录
DATA_DIR=

# CORS配置
CORS_ORIGIN=http://localhost:5173

# 默认密码
DEFAULT_PASSWORD=123456

# 数据源模式：fallback=MongoDB不可用时使用JSON；mongodb=严格模式
DATA_SOURCE_MODE=fallback
